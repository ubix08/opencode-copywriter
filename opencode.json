{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "copywriter-orchestrator",
  "skills": {
    "paths": [
      "/root/marketingskills/skills",
      "/root/social-media-skills/skills"
    ]
  },
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "notebooklm": {
      "type": "local",
      "command": ["npx", "notebooklm-mcp@latest"],
      "enabled": true,
      "environment": {
        "NOTEBOOKLM_PROFILE": "standard",
        "HEADLESS": "true"
      }
    }
  }
}
